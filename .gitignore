# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Personal data: your topics, digests, run state, model cache.
# Only the folder's own scaffolding is tracked.
user_data/*
!user_data/.gitkeep
!user_data/README.md

# Your editable summary templates, seeded here on first run. The pristine
# samples they are seeded from are tracked at src/papertracker/bundled_templates/.
/summary_templates/

# Tool caches
.pytest_cache/
.ruff_cache/

# Env / IDE / agent settings
.env
.DS_Store
.idea/
.vscode/
.claude/
